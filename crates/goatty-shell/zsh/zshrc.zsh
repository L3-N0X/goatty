# goatty managed zsh, startup file 3 of 3: .zshrc (interactive shells).
# Generated by goatty and rewritten whenever a session starts: don't edit.
# Your own additions go in ~/.config/goatty/zshrc (sourced near the end).
# Plain zsh with only your dotfiles instead: GOATTY_SHELL_MANAGED=0.
#
# Load order matters: options and completion first, then line-editor
# plugins, the prompt, shell integration, your additions, and syntax
# highlighting last (it has to wrap every widget defined before it).
# The tools themselves (fzf, Atuin, autosuggestions, Starship, syntax
# highlighting, and the plugins you install) are plugins: each loads in its
# slot from a generated plugins-*.zsh file.
#
# Every feature is optional: a missing tool is skipped and shows up in
# `goatty-status` and `goattyd shell status`.

# feature -> "ok<TAB>detail" | "missing" | "off"
typeset -gA _goatty_state
# package -> the zsh script found for it (system copy or goatty's)
typeset -gA _goatty_src

_goatty_on() { (( ${_goatty_features[(Ie)$1]} )) }
_goatty_find() {
  local f
  for f in "$@"; do
    [[ -r $f ]] && { REPLY=$f; return 0 }
  done
  return 1
}
_goatty_ok() { _goatty_state[$1]="ok"$'\t'"$2" }

# --- Options ----------------------------------------------------------------
setopt auto_cd auto_pushd pushd_ignore_dups pushd_silent
setopt interactive_comments no_beep
setopt complete_in_word always_to_end

# --- History (settings: history.*) -------------------------------------------
# Same file plain zsh would use, so existing history keeps working.
: ${HISTFILE:=${_goatty_user_zdotdir:-$HOME}/.zsh_history}
HISTSIZE=$_goatty_hist_size
SAVEHIST=$_goatty_hist_size
setopt $_goatty_hist_opts

# --- PATH -------------------------------------------------------------------
# Tools goatty installed (goatty-setup) come after the system's, so an
# installed package always wins.
typeset -gU path fpath
path+=("$_goatty_bin")

# --- Plugins: completion paths and environment -------------------------------
# Before compinit, so plugin completions are found. `goattyd plugin list`
# shows what's installed.
builtin source -- "$_goatty_dir/plugins-early.zsh"

# --- Keys -------------------------------------------------------------------
bindkey -e
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
() {
  local key
  local -A keys=(
    '^[[A'    up-line-or-beginning-search    # Up: history matching what's typed
    '^[OA'    up-line-or-beginning-search
    '^[[B'    down-line-or-beginning-search
    '^[OB'    down-line-or-beginning-search
    '^[[H'    beginning-of-line              # Home
    '^[OH'    beginning-of-line
    '^[[F'    end-of-line                    # End
    '^[OF'    end-of-line
    '^[[3~'   delete-char                    # Delete
    '^[[1;5C' forward-word                   # Ctrl+Right
    '^[[1;5D' backward-word                  # Ctrl+Left
    '^[[3;5~' kill-word                      # Ctrl+Delete
    '^H'      backward-kill-word             # Ctrl+Backspace
    '^[[Z'    reverse-menu-complete          # Shift+Tab
  )
  for key in ${(k)keys}; do
    bindkey -- $key ${keys[$key]}
  done
}
# Word motions stop at path separators.
WORDCHARS=${WORDCHARS//\/}

# --- Completion -------------------------------------------------------------
[[ -d $_goatty_cache ]] || mkdir -p -- "$_goatty_cache"
zmodload -i zsh/complist
autoload -Uz compinit
compinit -i -d "$_goatty_cache/zcompdump-$ZSH_VERSION"
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$_goatty_cache/zcompcache"

# --- The user's .zshrc (opt-in: GOATTY_ZSH_USER_RC=1) ----------------------
if (( _goatty_user_rc )); then
  _goatty_zdotdir_user
  if _goatty_user_file .zshrc; then
    builtin source -- "$REPLY"
  fi
  _goatty_zdotdir_capture
  builtin export ZDOTDIR=$_goatty_dir
fi

# --- Plugins: line editor tools --------------------------------------------
# fzf (Ctrl+T, Alt+C), then Atuin (Ctrl+R, so it keeps that key), then
# autosuggestions, which wraps the widgets defined before it.
builtin source -- "$_goatty_dir/plugins-line-editor.zsh"

# --- Prompt -----------------------------------------------------------------
# The Starship plugin (or another prompt plugin); goatty's config for it is
# generated from the prompt settings.
builtin source -- "$_goatty_dir/plugins-prompt.zsh"
if (( ! ${+_goatty_prompt} && ! _goatty_user_rc )); then
  # Small built-in prompt: directory, then a marker that turns red when
  # the last command failed.
  if (( _goatty_prompt_two_line )); then
    PROMPT='%F{blue}%~%f'$'\n''%(?.%F{green}.%F{red})%(!.#.❯)%f '
  else
    PROMPT='%F{blue}%~%f %(?.%F{green}.%F{red})%(!.#.❯)%f '
  fi
  RPROMPT=
fi

# --- Plugins: aliases and the plugins' own shell code ------------------------
# After the prompt; before your additions (so you can override a plugin's
# alias) and syntax highlighting.
builtin source -- "$_goatty_dir/plugins.zsh"

# --- Your aliases from goatty's settings (Aliases page, `goattyd alias`) ----
# After the plugins' aliases, so one of yours with the same name wins.
builtin source -- "$_goatty_dir/aliases.zsh"

# --- Shell integration: OSC 133 prompt marks, OSC 7 working directory -------
if _goatty_on integration && builtin source -- "$_goatty_dir/integration.zsh"; then
  _goatty_ok integration "$_goatty_dir/integration.zsh"
else
  _goatty_state[integration]=off
fi

# Nothing below needs goatty's ZDOTDIR: hand it back to the user now, so
# their additions (and everything started later) see their own.
_goatty_zdotdir_user

# --- The user's additions ---------------------------------------------------
if [[ -r $_goatty_user_zshrc ]]; then
  builtin source -- "$_goatty_user_zshrc"
fi

# --- Plugins that load last: syntax highlighting ---------------------------
# It wraps every line editor widget defined before it, yours included.
builtin source -- "$_goatty_dir/plugins-last.zsh"

# --- Commands ---------------------------------------------------------------

# What this shell loaded: feature<TAB>state[<TAB>detail].
goatty-status() {
  local k
  for k in ${(ko)_goatty_state}; do
    builtin print -r -- "$k"$'\t'"${_goatty_state[$k]}"
  done
}

# Install the missing tools of goatty's built-in plugins into goatty's data
# directory (no sudo), then reload. Named ones (`goatty-setup fzf`) too.
goatty-setup() {
  local daemon=${_goatty_daemon:-goattyd}
  if [[ $1 == --dismiss ]]; then
    "$daemon" shell dismiss
    return
  fi
  if (( $# == 0 )); then
    local -a missing=(${(ko)_goatty_state[(R)missing]})
    set -- ${missing:*_goatty_setup_defaults}
    if (( $# == 0 )); then
      builtin print -r -- "goatty: nothing to install (see goatty-status)"
      return 0
    fi
  fi
  "$daemon" shell install -- "$@" && goatty-reload
}

# Restart this shell with goatty's configuration.
goatty-reload() {
  if (( ${+ZDOTDIR} )); then
    builtin export GOATTY_ORIG_ZDOTDIR=$ZDOTDIR
  fi
  ZDOTDIR=$_goatty_dir builtin exec "${commands[zsh]:-zsh}" -l
}

# --- Reload on request -------------------------------------------------------
# After host settings change, goatty can ask running shells to pick up the
# new configuration: it sends SIGURG (ignored by default, so other programs
# don't care). An idle, empty prompt reloads right away; otherwise the shell
# reloads at its next prompt. A shell with jobs only says so: exec would
# lose them.
builtin zmodload -F zsh/parameter p:jobstates 2>/dev/null
typeset -gi _goatty_reload_pending=0

_goatty_reload_requested() {
  (( _goatty_reload_pending )) || return 0
  _goatty_reload_pending=0
  if (( ${#jobstates} )); then
    builtin print -r -- $'\e[33mgoatty:\e[0m shell settings changed; run \e[1mgoatty-reload\e[0m once your jobs are done.'
    return 0
  fi
  goatty-reload
}

# Abandon the empty line, so the precmd hook runs and reloads. (From a trap,
# accept-line would only take effect on the next keypress; send-break
# returns to the top level at once.)
# Only touch zle from inside the trap when the builtin is really there. The
# signal can arrive before zle is loaded (non-interactive, or a build where
# the zle module isn't available); then the flag stays set and the reload
# happens at the next prompt instead.
_goatty_reload_idle() {
  (( $+builtins[zle] )) || return 0
  [[ $CONTEXT == start && -z $BUFFER ]] && zle .send-break
}
(( $+builtins[zle] )) && zle -N _goatty_reload_idle

TRAPURG() {
  _goatty_reload_pending=1
  zle && zle _goatty_reload_idle
  return 0
}

# The signal can also land after precmd but before zle reads the new line
# (while the prompt is drawn): `zle` isn't active yet, so the trap only sets
# the flag. Catch that when the line editor starts, or an idle shell would
# wait for the next command to reload.
if (( $+builtins[zle] )); then
  _goatty_reload_line_init() {
    (( _goatty_reload_pending )) && [[ -z $BUFFER ]] && zle .send-break
    return 0
  }
  builtin autoload -Uz add-zle-hook-widget
  add-zle-hook-widget line-init _goatty_reload_line_init
fi

builtin autoload -Uz add-zsh-hook
add-zsh-hook precmd _goatty_reload_requested

# --- Missing-tools hint -----------------------------------------------------
() {
  local -a missing=(${(ko)_goatty_state[(R)missing]})
  missing=(${missing:*_goatty_setup_defaults})
  (( $#missing )) && [[ -t 1 && ! -e $_goatty_hint_marker ]] || return 0
  builtin print -r -- $'\e[33mgoatty:\e[0m not installed: '"${(j:, :)missing}"$'. Run \e[1mgoatty-setup\e[0m to install (user space, no sudo), \e[1mgoatty-setup --dismiss\e[0m to hide this.'
}

# --- Done --------------------------------------------------------------------
builtin unfunction _goatty_zdotdir_user _goatty_zdotdir_capture _goatty_user_file _goatty_on _goatty_find _goatty_ok
builtin unset _goatty_user_zdotdir _goatty_src _goatty_prompt
