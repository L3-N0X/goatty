# goatty shell integration for zsh. Kept small and readable on purpose.
# Generated by goatty; turn it off with shell.zsh.integration = false.
#
# OSC 133 marks each prompt cycle, so the terminal knows where commands and
# their output begin and how they ended:
#   A  prompt starts            B  prompt ends, input starts
#   C  command output starts    D;<status>  command finished
# OSC 7 reports the working directory as a file:// URL.
#
# Reference: https://gitlab.freedesktop.org/Per_Bothner/specifications/blob/master/proposals/semantic-prompts.md

typeset -gi _goatty_running=0

_goatty_report_cwd() {
  emulate -L zsh -o no_multibyte -o extended_glob
  local LC_ALL=C
  # Percent-encode every byte outside the URL-safe set.
  builtin print -rn -- $'\e]7;file://'"${HOST}${PWD//(#m)[^A-Za-z0-9\/._~-]/%${(l:2::0:)$(( [##16] #MATCH ))}}"$'\e\\'
}

_goatty_precmd() {
  local ret=$?
  if (( _goatty_running )); then
    builtin print -rn -- $'\e]133;D;'"$ret"$'\a'
    _goatty_running=0
  fi
  _goatty_report_cwd
  # Mark the prompt inside PS1 so a redraw (e.g. after a resize) re-marks
  # it. Prompt themes set PS1 before this hook runs; checking every time
  # keeps the marks when a theme rebuilds PS1.
  [[ $PS1 == *$'\e]133;A'* ]] || PS1=$'%{\e]133;A\a%}'$PS1
  [[ $PS1 == *$'\e]133;B'* ]] || PS1=$PS1$'%{\e]133;B\a%}'
}

_goatty_preexec() {
  builtin print -rn -- $'\e]133;C\a'
  _goatty_running=1
}

builtin autoload -Uz add-zsh-hook
add-zsh-hook precmd _goatty_precmd
add-zsh-hook preexec _goatty_preexec
