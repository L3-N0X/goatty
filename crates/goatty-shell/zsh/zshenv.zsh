# goatty managed zsh, startup file 1 of 3: .zshenv (read by every zsh).
# Generated by goatty and rewritten whenever a session starts: don't edit.
# Your own additions go in ~/.config/goatty/zshrc.
#
# goatty starts zsh with ZDOTDIR pointing at this directory. This file puts
# the user's ZDOTDIR back and sources their .zshenv. For interactive shells
# it then points ZDOTDIR here again, so zsh reads goatty's .zprofile and
# .zshrc next. The end of .zshrc restores the user's ZDOTDIR for good, so
# .zlogin, .zlogout and any zsh started later behave like plain zsh.

if (( ${+GOATTY_ORIG_ZDOTDIR} )); then
  typeset -g _goatty_user_zdotdir=$GOATTY_ORIG_ZDOTDIR
else
  builtin unset _goatty_user_zdotdir
fi
builtin unset GOATTY_ORIG_ZDOTDIR

# Point ZDOTDIR at the user's startup files (unset: $HOME).
_goatty_zdotdir_user() {
  if (( ${+_goatty_user_zdotdir} )); then
    builtin export ZDOTDIR=$_goatty_user_zdotdir
  else
    builtin unset ZDOTDIR
  fi
}
# Remember the user's ZDOTDIR after their file ran (it may have set one).
_goatty_zdotdir_capture() {
  if (( ${+ZDOTDIR} )); then
    typeset -g _goatty_user_zdotdir=$ZDOTDIR
  else
    builtin unset _goatty_user_zdotdir
  fi
}
# The user's startup file $1 -> REPLY, if it exists and isn't goatty's own
# (a ZDOTDIR pointing back here would make the file source itself).
_goatty_user_file() {
  local dir=${ZDOTDIR:-$HOME}
  REPLY=$dir/$1
  [[ ${dir:A} != ${_goatty_dir:A} && -r $REPLY ]]
}

if ! builtin source -- "$ZDOTDIR/settings.zsh"; then
  # Without settings, behave like plain zsh: zsh reads the rest of the
  # user's startup files from their own ZDOTDIR.
  _goatty_zdotdir_user
  builtin unfunction _goatty_zdotdir_user _goatty_zdotdir_capture _goatty_user_file
  builtin return
fi
_goatty_zdotdir_user

# Sourced at top level, not from a function: `typeset` in the user's file
# must create globals.
if (( _goatty_user_env )) && _goatty_user_file .zshenv; then
  builtin source -- "$REPLY"
fi

if [[ -o interactive ]]; then
  _goatty_zdotdir_capture
  builtin export ZDOTDIR=$_goatty_dir
  # Debian/Ubuntu's /etc/zsh/zshrc runs compinit unless this is set;
  # goatty's .zshrc runs it once, with its own dump file.
  typeset -g skip_global_compinit=1
else
  builtin unfunction _goatty_zdotdir_user _goatty_zdotdir_capture _goatty_user_file
fi
